{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Marmot-TS",
  "sourceLinkTemplate": "https://github.com/marmot-protocol/marmot-ts/blob/{gitRevision}/{path}#L{line}",
  "entryPointStrategy": "resolve",
  "entryPoints": [
    "src/index.ts",
    "src/mls.ts",
    "src/client/index.ts",
    "src/core/index.ts",
    "src/engine/index.ts",
    "src/audit/index.ts",
    "src/extra/index.ts",
    "src/extra/audit/node.ts",
    "src/extra/audit/browser.ts",
    "src/utils/index.ts"
  ],
  "displayBasePath": "src",
  "excludeInternal": true,
  "treatWarningsAsErrors": true,
  "out": ".vitepress/dist/reference",
  "basePath": "/reference",
  "navigation": {
    "includeCategories": true,
    "includeGroups": true,
    "includeFolders": true,
    "excludeReferences": true
  },
  "categorizeByGroup": false,
  "plugin": ["./typedocs/cascade-category.mjs"],
  "blockTags": [
    "@alpha",
    "@author",
    "@beta",
    "@category",
    "@categoryDescription",
    "@default",
    "@defaultValue",
    "@deprecated",
    "@example",
    "@experimental",
    "@group",
    "@groupDescription",
    "@inheritDoc",
    "@internal",
    "@license",
    "@module",
    "@param",
    "@privateRemarks",
    "@public",
    "@remarks",
    "@returns",
    "@satisfies",
    "@see",
    "@since",
    "@template",
    "@throws",
    "@typeParam",
    "@warning",
    "@yields"
  ],
  "externalSymbolLinkMappings": {
    "applesauce-core": {
      "Rumor": "https://applesauce.build/typedoc/types/applesauce-core.Helpers.Rumor.html"
    },
    "nostr-tools": {
      "NostrEvent": "https://applesauce.build/typedoc/types/applesauce-core.Helpers.NostrEvent.html"
    },
    "applesauce-common": {
      "Rumor": "https://applesauce.build/typedoc/types/applesauce-common.Helpers.Rumor.html",
      "FileMetadataFields": "https://applesauce.build/typedoc/types/applesauce-common.Helpers.FileMetadataFields.html",
      "getFileMetadata": "https://applesauce.build/typedoc/functions/applesauce-common.Helpers.getFileMetadata.html",
      "getFileMetadataFromImetaTag": "https://applesauce.build/typedoc/functions/applesauce-common.Helpers.getFileMetadataFromImetaTag.html"
    },
    "typescript": {
      "NumberConstructor.MAX_SAFE_INTEGER": "https://tc39.es/ecma262/multipage/numbers-and-dates.html#sec-number.max_safe_integer"
    }
  }
}
