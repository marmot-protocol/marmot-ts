{
  "name": "@internet-privacy/marmot-ts",
  "version": "0.6.0",
  "type": "module",
  "description": "Marmot protocol implementation in TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepare": "pnpm --filter ts-mls build",
    "build": "pnpm run clean && pnpm --filter ts-mls build && pnpm run compile && pnpm run vendor",
    "clean": "rimraf ./dist",
    "compile": "tsc -b tsconfig.build.json",
    "vendor": "node scripts/vendor-ts-mls.mjs",
    "prepublishOnly": "pnpm run build",
    "release": "pnpm build && node scripts/verify-package-tarball.mjs --check-fork-unpublished && changeset publish --provenance",
    "release-next": "./scripts/release-next.sh",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest",
    "conformance:extended": "vitest run --config vitest.extended.config.ts",
    "docs": "vitepress dev",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "postdocs:build": "pnpm run typedoc:build",
    "docs:preview": "vitepress preview",
    "typedoc:build": "typedoc",
    "typedoc:serve": "pnpx serve .vitepress/dist/reference"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmot-protocol/marmot-ts.git"
  },
  "keywords": [
    "nostr",
    "mls",
    "marmot"
  ],
  "author": "Marmot Protocol",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/marmot-protocol/marmot-ts/issues"
  },
  "homepage": "https://github.com/marmot-protocol/marmot-ts#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.1.0",
    "deno": ">=2.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mls": {
      "types": "./dist/mls.d.ts",
      "import": "./dist/mls.js",
      "default": "./dist/mls.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js",
      "default": "./dist/engine/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "import": "./dist/audit/index.js",
      "default": "./dist/audit/index.js"
    },
    "./extra": {
      "types": "./dist/extra/index.d.ts",
      "import": "./dist/extra/index.js",
      "default": "./dist/extra/index.js"
    },
    "./extra/audit/node": {
      "types": "./dist/extra/audit/node.d.ts",
      "import": "./dist/extra/audit/node.js",
      "default": "./dist/extra/audit/node.js"
    },
    "./extra/audit/browser": {
      "types": "./dist/extra/audit/browser.d.ts",
      "import": "./dist/extra/audit/browser.js",
      "default": "./dist/extra/audit/browser.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@hpke/core": "1.9.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0",
    "applesauce-common": "^6.2.0",
    "applesauce-core": "^6.2.0",
    "debug": "^4.4.3",
    "eventemitter3": "^5.0.4"
  },
  "peerDependencies": {
    "@hpke/chacha20poly1305": "1.8.0",
    "@hpke/dhkem-x448": "1.8.0",
    "@hpke/hybridkem-x-wing": "0.7.0",
    "@hpke/ml-kem": "0.3.0",
    "@noble/post-quantum": "0.6.1"
  },
  "peerDependenciesMeta": {
    "@hpke/chacha20poly1305": {
      "optional": true
    },
    "@hpke/dhkem-x448": {
      "optional": true
    },
    "@hpke/hybridkem-x-wing": {
      "optional": true
    },
    "@hpke/ml-kem": {
      "optional": true
    },
    "@noble/post-quantum": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.13.2",
    "applesauce-accounts": "^6.2.0",
    "prettier": "^3.9.3",
    "rimraf": "~6.0.1",
    "ts-mls": "workspace:*",
    "typedoc": "^0.28.19",
    "typescript": "~6.0.3",
    "vitepress": "2.0.0-alpha.17",
    "vitest": "^3.2.6"
  }
}
