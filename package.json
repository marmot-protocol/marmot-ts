{
  "name": "@internet-privacy/marmot-ts",
  "version": "0.5.1",
  "type": "module",
  "description": "Marmot protocol implementation in TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepare": "cd ts-mls && pnpm install && pnpm build",
    "build": "pnpm run clean && pnpm run compile",
    "clean": "rimraf ./dist",
    "compile": "tsc -b tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "release": "pnpm build && changeset publish --provenance",
    "release-next": "./scripts/release-next.sh",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest",
    "docs": "vitepress dev",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "postdocs:build": "pnpm run typedoc:build",
    "docs:preview": "vitepress preview",
    "typedoc:build": "typedoc",
    "typedoc:serve": "pnpx serve .vitepress/dist/reference"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmot-protocol/marmot-ts.git"
  },
  "keywords": [
    "nostr",
    "mls",
    "marmot"
  ],
  "author": "Marmot Protocol",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/marmot-protocol/marmot-ts/issues"
  },
  "homepage": "https://github.com/marmot-protocol/marmot-ts#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.1.0",
    "deno": ">=2.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mls": {
      "types": "./src/mls.d.ts",
      "import": "./src/mls.js",
      "default": "./src/mls.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js",
      "default": "./dist/engine/index.js"
    },
    "./extra": {
      "types": "./dist/extra/index.d.ts",
      "import": "./dist/extra/index.js",
      "default": "./dist/extra/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@hpke/core": "^1.9.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0",
    "applesauce-common": "^5.2.0",
    "applesauce-core": "^5.2.0",
    "debug": "^4.4.3",
    "eventemitter3": "^5.0.4",
    "ts-mls": "./ts-mls"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.12.4",
    "applesauce-accounts": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "rimraf": "~6.0.1",
    "typedoc": "^0.28.19",
    "typescript": "~6.0.3",
    "vitepress": "2.0.0-alpha.17",
    "vitest": "^3.2.4"
  }
}
